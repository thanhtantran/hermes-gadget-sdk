# ESP32-2432S028 CYD: classic ESP32, 4 MB flash, no PSRAM, ILI9341.
# Stack with the root sdkconfig.defaults; do not use S3 board defaults.
CONFIG_IDF_TARGET="esp32"
CONFIG_HG_BOARD_ESP32_CYD=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# CONFIG_SPIRAM is not set
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Keep the main stack at 8 KiB for QR setup and diagnostics. Reduce radio and
# TCP buffers instead: the framebuffer already consumes 150 KiB internal RAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
# IPv4-only on this memory-constrained profile. IPv6's static neighbor and
# routing tables would reduce the contiguous startup heap below the LCD budget.
# CONFIG_LWIP_IPV6 is not set
